{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cobbleandcandle/hours-strip",
  "title": "Hours Strip",
  "category": "cobbleandcandle",
  "description": "Tonight's status, address, phone with today's hours, and all locations, for the visitor's current location.",
  "keywords": ["hours", "open", "location", "phone"],
  "textdomain": "cobbleandcandle-core",
  "attributes": {
    "tonightNote": { "type": "string", "default": "Tonight’s seatings · 6:00 & 8:30" },
    "locationsUrl": { "type": "string", "default": "/locations/" }
  },
  "supports": { "html": false, "align": ["full"] }
}
