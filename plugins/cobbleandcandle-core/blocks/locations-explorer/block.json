{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cobbleandcandle/locations-explorer",
  "title": "Locations Explorer",
  "category": "cobbleandcandle",
  "description": "Buttons for each house that switch a panel with its map, address, hours, holiday hours and getting there.",
  "keywords": ["locations", "map", "hours", "address", "find us"],
  "textdomain": "cobbleandcandle-core",
  "attributes": {
    "reserveUrl": { "type": "string", "default": "/reservations/" },
    "reserveLabel": { "type": "string", "default": "Reserve a table" }
  },
  "supports": { "html": false, "align": ["full"] }
}
