{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cobbleandcandle/events-list",
  "title": "Upcoming Events",
  "category": "cobbleandcandle",
  "description": "The next few events as cards with a date box.",
  "keywords": ["events", "what's on"],
  "textdomain": "cobbleandcandle",
  "attributes": {
    "eyebrow": { "type": "string", "default": "Events & specials" },
    "title": { "type": "string", "default": "What’s on" },
    "intro": { "type": "string", "default": "Suppers, music and seasonal nights across all three houses." },
    "count": { "type": "number", "default": 3 },
    "linkUrl": { "type": "string", "default": "/events/" },
    "linkLabel": { "type": "string", "default": "All events" }
  },
  "supports": { "html": false, "align": ["full"] }
}
