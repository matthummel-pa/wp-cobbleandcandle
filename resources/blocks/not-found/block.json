{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cobbleandcandle/not-found",
  "title": "Page Not Found",
  "category": "cobbleandcandle",
  "description": "A friendly 404: message, ways back, a search box and every house with its open-now status.",
  "keywords": ["404", "not found", "error"],
  "textdomain": "cobbleandcandle",
  "attributes": {
    "eyebrow": { "type": "string", "default": "Error 404 · Page not found" },
    "title": { "type": "string", "default": "This lane is unlit." },
    "text": { "type": "string", "default": "The page you were after has slipped down a side street. Let us light the way back." },
    "menuUrl": { "type": "string", "default": "/menu/" },
    "reserveUrl": { "type": "string", "default": "/reservations/" },
    "imageId": { "type": "number", "default": 0 }
  },
  "supports": { "html": false, "align": ["full"] }
}
